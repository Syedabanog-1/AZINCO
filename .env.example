# AZINCO — environment template.
# Copy to `.env` (git-ignored) and replace every placeholder.
# NEVER put real secrets in this file or in any committed file.

# ---------- General ----------
AZINCO_ENV=local                      # local | ci | dev | staging | prod
AZINCO_BASE_CURRENCY=PKR              # DEC-12 (owner decision)
AZINCO_LOG_LEVEL=INFO

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=azinco
# Superuser used only by the postgres container on first start
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# Migration role (owns tables, used only by Alembic)
AZINCO_DB_MIGRATOR_PASSWORD=change-me-migrator
# Application roles (no BYPASSRLS, not table owners)
AZINCO_DB_APP_PASSWORD=change-me-app
AZINCO_DB_WORKER_PASSWORD=change-me-worker
AZINCO_DB_LEDGER_PASSWORD=change-me-ledger
AZINCO_DB_AUDIT_PASSWORD=change-me-audit
AZINCO_DB_READONLY_PASSWORD=change-me-readonly
# NOTE: role passwords are applied only when the postgres volume is first created.
# To change them later: docker compose ... down -v (DELETES local data) and up again.

# ---------- Redis ----------
REDIS_URL=redis://:change-me-redis@localhost:6379/0
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# ---------- ClamAV / Mailpit (local only) ----------
CLAMAV_PORT=3310
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- Object storage (S3-compatible, [MOCK] locally) ----------
# Default image: cgr.dev/chainguard/minio:latest (MinIO stopped publishing community images
# in Oct 2025). Any S3-compatible image can be used; see infra/docker/README.md.
S3_IMAGE=cgr.dev/chainguard/minio:latest
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key-min-8-chars
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET_DOCUMENTS=azinco-documents
S3_BUCKET_ARCHIVE=azinco-archive

# ---------- Auth (ADR-006, option a: FastAPI-native) ----------
AZINCO_SESSION_SECRET=change-me-generate-64-random-bytes
AZINCO_CSRF_SECRET=change-me-generate-32-random-bytes
AZINCO_SESSION_TTL_MINUTES=60

# ---------- Model Gateway ----------
# [MOCK] is the default; real providers are optional in local/dev and budget-capped.
AZINCO_MODEL_PROVIDER=mock            # mock | openai | anthropic | gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZINCO_MODEL_DAILY_BUDGET_USD=5

# ---------- Payments ----------
# [MOCK] by default. Provider identities are configured by Platform Admin in back-office,
# never exposed client-side. Client-facing label for domestic payments: "Banking Channels".
AZINCO_PAYMENTS_MODE=mock             # mock | sandbox
AZINCO_FUNDS_HANDLING_DEFAULT=ledger  # ledger (Option A, default) | segregated (Option B, disabled)

# ---------- API ----------
API_PORT=8000

# ---------- Web ----------
WEB_PORT=3000
# Server-side only (never sent to the browser). Compose sets it to http://api:8000.
AZINCO_API_INTERNAL_URL=http://localhost:8000
